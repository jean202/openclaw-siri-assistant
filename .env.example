# OpenClaw Siri Assistant Configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# HTTP server port
PORT=3456

# API secret (auto-generated if not set)
# API_SECRET=your-secret-here

# OpenClaw CLI binary path
OPENCLAW_BIN=openclaw

# Request timeout in seconds
TIMEOUT_SEC=120

# Maximum JSON request body size in bytes
MAX_BODY_BYTES=32768

# cloudflared transport for ephemeral tunnels.
# http2 is more reliable when QUIC/UDP is blocked or unstable.
CLOUDFLARED_PROTOCOL=http2

# Session timeout in minutes (new session after this much inactivity)
SESSION_TIMEOUT_MIN=30

# System prompt for AI responses
# SYSTEM_PROMPT="You are a helpful personal AI assistant called via Siri."

# System prompt for /music. It should return JSON with intent, query, and reply.
# MUSIC_SYSTEM_PROMPT="You extract a playable Apple Music query from a Siri music request."

# Preferred music service for /music responses.
# apple_music can autoplay through the generated PlayOpenClawMusic shortcut.
# melon can return the same query for Melon's "음악검색하기" Shortcut action,
# but cannot autoplay unless Melon exposes a play action on iPhone.
MUSIC_SERVICE=apple_music

# --- Named Tunnel (optional, for fixed URL) ---
# Set TUNNEL_NAME to use a named cloudflared tunnel instead of ephemeral URLs.
# Requires: cloudflared tunnel login && cloudflared tunnel create <name>
# TUNNEL_NAME=siri-assistant

# If using a custom domain with named tunnel:
# TUNNEL_HOSTNAME=siri.yourdomain.com

# --- LaunchAgent ---
# Auto-start is managed via: ./install-launchagent.sh
# Uninstall with: ./install-launchagent.sh uninstall
